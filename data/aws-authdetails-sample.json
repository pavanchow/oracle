        {
          "PolicyName": "dev-inline",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              { "Effect": "Allow", "Action": "s3:ListBucket", "Resource": "arn:aws:s3:::prod-artifacts" },
              { "Effect": "Allow", "Action": "sts:AssumeRole", "Resource": "arn:aws:iam::123456789012:role/deployer" }
            ]
          }
