              {
                "Effect": "Allow",
                "Action": "s3:PutObject",
                "Resource": "arn:aws:s3:::prod-artifacts/*",
                "Condition": { "Bool": { "aws:MultiFactorAuthPresent": "true" } }
              }
            ]
          }
        }
